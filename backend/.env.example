# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ── Agnes AI ──────────────────────────────────────────────
# Leave AGNES_API_KEY empty to use the built-in local writer,
# which still produces a real digest from the collected feeds.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# ── Daily digest ──────────────────────────────────────────
# Directory holding the generated YYYY-MM-DD.mdx documents
CONTENT_DIR=
# Timezone used for the 00:00 publication moment
DIGEST_TIMEZONE=Asia/Shanghai
# Token required by POST /api/digests/generate when set
ADMIN_TOKEN=
# How many past days to backfill when the archive is empty
BACKFILL_DAYS=3
